<?xml version="1.0" encoding="UTF-8"?>
<!-- Налаштування логера для тестів: лише консоль і лише WARN та вище, щоб тести не шуміли.
     Logback автоматично бере logback-test.xml замість logback.xml, якщо він є на classpath. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
